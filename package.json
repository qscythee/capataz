{
  "name": "capataz",
  "displayName": "Capataz",
  "description": "Feature-based Systems management for Rojo projects. Opt-in by adding a capataz.config.json at the workspace root.",
  "version": "0.0.1",
  "publisher": "qscythee",
  "license": "MIT",
  "author": "qscythee",
  "repository": { "type": "git", "url": "https://github.com/qscythee/capataz.git" },
  "bugs": { "url": "https://github.com/qscythee/capataz/issues" },
  "homepage": "https://github.com/qscythee/capataz#readme",
  "keywords": ["roblox", "luau", "rojo", "rokit", "systems", "lint"],
  "engines": {
    "node": ">=22.18.0",
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "capataz": "./dist/cli.cjs"
  },
  "contributes": {
    "configuration": {
      "title": "Capataz",
      "properties": {
        "capataz.lint.run": {
          "type": "string",
          "enum": ["onChange", "onSave"],
          "enumDescriptions": [
            "Update diagnostics while editing, after a short pause.",
            "Check saved file contents. Unsaved edits do not update diagnostics."
          ],
          "default": "onChange",
          "scope": "resource",
          "description": "When Capataz updates Luau import and runtime boundary diagnostics. Project structure and configuration changes always trigger checks."
        }
      }
    },
    "commands": [
      {
        "command": "capataz.check",
        "title": "Capataz: Check Runtime Boundaries"
      },
      {
        "command": "capataz.init",
        "title": "Capataz: Init"
      },
      {
        "command": "capataz.generateProject",
        "title": "Capataz: Regenerate Project"
      },
      {
        "command": "capataz.newSystem",
        "title": "Capataz: New System"
      },
      {
        "command": "capataz.deleteSystem",
        "title": "Capataz: Delete System"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "capataz.newSystem",
          "when": "explorerResourceIsFolder && resourceFilename == Systems",
          "group": "capataz"
        },
        {
          "command": "capataz.deleteSystem",
          "when": "explorerResourceIsFolder && resourcePath =~ /[\\/]Systems[\\/][^\\/]+$/",
          "group": "capataz"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "package:cli": "npm run build:cli && node scripts/package-cli.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run build:cli",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
